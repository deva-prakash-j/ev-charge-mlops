# Template. Copy to .env and fill in — .env is gitignored, this file is not.
#   PowerShell:  Copy-Item .env.example .env
# Never put a real token in this file.

# ACN-Data API token from https://ev.caltech.edu/dataset (free registration).
ACN_API_TOKEN=

# Override only if the ACN-Data API moves.
ACN_API_URL=https://ev.caltech.edu/api/v1/

# Local data root. Gitignored.
DATA_DIR=data

# Where run reports are written. Gitignored except the PII audit.
ARTIFACTS_DIR=artifacts
