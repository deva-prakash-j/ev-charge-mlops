# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Data — the licensed ACN-Data extract is not redistributable.
# Ignore data/ contents rather than the directory, so the synthetic fixture in
# data/sample/ can be re-included (git cannot un-ignore inside an ignored dir).
data/*
!data/sample/

# ML artifacts
mlruns/
mlartifacts/
*.joblib
great_expectations/uncommitted/

# Models trained on the licensed extract are not published; the sample model is,
# so an evaluator has a concrete artefact without running training first.
models/raw/
!models/sample/model.joblib

# Generated run outputs. pii_audit.json is kept deliberately: it is the evidence
# behind the no-PII declaration and cannot be regenerated without the licensed
# extract, which is not redistributable.
artifacts/*
!artifacts/pii_audit.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
