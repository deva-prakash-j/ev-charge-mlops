# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Data — real ACN-Data records stay out of the repository, which is the whole
# submission (see DATA_LICENCE.md); evaluators fetch them with their own free token.
# Ignore data/ contents rather than the directory, so the synthetic data in
# data/sample/ and data/synthetic/ can be re-included (git cannot un-ignore
# inside an ignored dir).
# Data manifests hold counts and hashes only, so they are published.
data/*
!data/sample/
!data/synthetic/
data/synthetic/reference/
!data/raw/
data/raw/*
!data/raw/manifest.json
!data/reference/
data/reference/*
!data/reference/manifest.json

# ML artifacts
mlruns/
mlartifacts/
*.joblib
great_expectations/uncommitted/

# Models trained on the licensed extract are not published; the sample model is,
# so an evaluator has a concrete artefact without running training first.
models/raw/
models/raw_dwell/
models/sample_dwell/
models/synthetic/
models/synthetic_dwell/
!models/sample/model.joblib

# Generated run outputs. pii_audit.json is kept deliberately: it is the evidence
# behind the no-PII declaration and cannot be regenerated without the licensed
# extract, which is not published in this repository.
artifacts/*
!artifacts/pii_audit.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
